{
  "name": "volt",
  "private": true,
  "version": "0.3.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "description": "Lightning-fast keyboard-driven launcher for Windows, macOS, and Linux. Built with Tauri 2 + React + Rust.",
  "license": "Apache-2.0",
  "author": {
    "name": "VoltLaunchr Contributors",
    "url": "https://voltlaunchr.com"
  },
  "homepage": "https://voltlaunchr.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/VoltLaunchr/Volt.git"
  },
  "bugs": {
    "url": "https://github.com/VoltLaunchr/Volt/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "pwsh -File scripts/build.ps1",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bump-version": "node scripts/bump-version.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "generate-changelog": "node scripts/generate-changelog.mjs",
    "generate:app-icons": "node scripts/generate-app-icons.mjs",
    "check-version": "node scripts/sync-version.mjs --check",
    "setup-hooks": "node scripts/setup-hooks.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
