{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "Permissions for the settings window. Excludes shell/launcher/quicklink-launch and other run-stuff verbs (settings UI does not execute commands or launch apps). Includes settings/auth/credentials/sync/extensions/hotkey/autostart/app_shortcuts/clipboard control + dialog (export/import + extension folder picker) + opener (external links and log file) + updater (check + install) + autostart (toggle launch-on-boot) + deep-link (OAuth callbacks).",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "core:window:allow-set-effects",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "autostart:default",
    "dialog:default",
    "updater:default",
    "deep-link:default",
    "os:default",

    "allow-load-settings",
    "allow-save-settings",
    "allow-update-general-settings",
    "allow-update-appearance-settings",
    "allow-update-hotkey-settings",
    "allow-update-indexing-settings",
    "allow-update-plugin-settings",
    "allow-update-shortcuts-settings",
    "allow-update-shell-settings",
    "allow-get-theme",
    "allow-set-theme",
    "allow-get-app-shortcuts",
    "allow-get-app-icon",
    "allow-save-app-shortcut",
    "allow-delete-app-shortcut",
    "allow-sync-app-shortcuts",
    "allow-export-settings",
    "allow-import-settings",

    "allow-set-global-hotkey",
    "allow-get-current-hotkey",

    "allow-enable-autostart",
    "allow-disable-autostart",
    "allow-is-autostart-enabled",

    "allow-set-window-position",
    "allow-get-window-position",
    "allow-update-show-on-screen",

    "allow-list-plugins",
    "allow-get-all-plugins-info",
    "allow-get-plugin-count",
    "allow-get-enabled-plugin-count",
    "allow-is-plugin-registered",
    "allow-get-plugin-capabilities",
    "allow-list-external-plugins",
    "allow-get-plugins-directory",
    "allow-validate-external-plugin",
    "allow-load-plugin-from-file",
    "allow-load-plugins-from-directory",
    "allow-get-builtin-plugin-metadata",

    "allow-fetch-extension-registry",
    "allow-get-installed-extensions",
    "allow-install-extension",
    "allow-uninstall-extension",
    "allow-toggle-extension",
    "allow-update-extension-permissions",
    "allow-check-extension-updates",
    "allow-update-extension",
    "allow-get-extension-details",
    "allow-read-extension-source",
    "allow-get-enabled-extensions-sources",
    "allow-get-extension-tamper-alert",
    "allow-acknowledge-extension-tamper-alert",
    "allow-fetch-extension-downloads",
    "allow-increment-extension-download",

    "allow-scaffold-extension",
    "allow-get-dev-extensions",
    "allow-link-dev-extension",
    "allow-unlink-dev-extension",
    "allow-toggle-dev-extension",
    "allow-get-dev-extensions-path",
    "allow-refresh-dev-extension",
    "allow-get-dev-reload-signal",

    "allow-get-extension-preference",
    "allow-set-extension-preference",
    "allow-get-extension-secret",
    "allow-set-extension-secret",
    "allow-ext-oauth-start",
    "allow-ext-oauth-get-token",
    "allow-ext-oauth-revoke-token",

    "allow-save-credential",
    "allow-has-credential",
    "allow-delete-credential",
    "allow-get-credential-info",
    "allow-test-credential",

    "allow-auth-login",
    "allow-auth-get-session",
    "allow-auth-get-profile",
    "allow-auth-refresh-token",
    "allow-auth-logout",

    "allow-get-github-oauth-url",
    "allow-get-notion-oauth-url",
    "allow-is-oauth-pending",
    "allow-clear-oauth-pending",

    "allow-sync-push",
    "allow-sync-pull",
    "allow-get-sync-status",

    "allow-get-snippets",
    "allow-create-snippet",
    "allow-update-snippet",
    "allow-delete-snippet",
    "allow-expand-snippet",
    "allow-import-snippets",
    "allow-export-snippets",
    "allow-set-snippet-expansion-enabled",

    "allow-get-notes",
    "allow-get-trash",
    "allow-create-note",
    "allow-update-note",
    "allow-delete-note",
    "allow-empty-trash",
    "allow-export-notes",
    "allow-import-notes",
    "allow-open-notes-window",

    "allow-get-quicklinks",
    "allow-save-quicklink",
    "allow-delete-quicklink",

    "allow-get-clipboard-history",
    "allow-search-clipboard-history",
    "allow-toggle-clipboard-pin",
    "allow-delete-clipboard-item",
    "allow-clear-clipboard-history",
    "allow-start-clipboard-monitoring",
    "allow-stop-clipboard-monitoring",
    "allow-is-clipboard-monitoring",
    "allow-set-clipboard-retention-days",
    "allow-set-clipboard-disabled-apps",

    "allow-get-app-history",
    "allow-clear-launch-history",
    "allow-remove-from-history",
    "allow-get-history-count",

    "allow-scan-applications",
    "allow-invalidate-index",
    "allow-get-index-status",
    "allow-get-db-index-stats",
    "allow-start-file-watcher",

    "allow-record-shell-command",
    "allow-get-shell-history",
    "allow-pin-shell-command",
    "allow-clear-shell-history",
    "allow-remove-shell-command",

    "allow-get-log-file-path",

    "allow-ai-get-providers-status",
    "allow-ai-set-global-key",
    "allow-ai-delete-global-key",
    "allow-ai-verify-key",
    "allow-ai-profile-get",
    "allow-ai-profile-set",
    "allow-ai-quick-actions-get",
    "allow-ai-quick-actions-save",
    "allow-ai-quick-actions-apply-all",
    "allow-ai-pro-features-enabled"
  ]
}
